pipeline {
    agent any

    environment {
        // Optional: XRPL_WHITELISTED_RPC replaces the sdk's default XRPL endpoints (xrplcluster.com, s1/s2.ripple.com);
        // XRPL_RPC only adds endpoints in front of them. ELASTICSEARCH_CONFIG must be available, as for the other custom scripts.
        // XRPL_WHITELISTED_RPC = credentials('xrpl-rpc-url')
        NODE_OPTIONS = '--max-old-space-size=4096'
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
        timestamps()
    }

    stages {
        stage('Setup') {
            steps {
                nodejs(nodeJSInstallationName: 'node') {
                    sh '''
                        node --version
                        which pnpm || npm install -g pnpm
                        pnpm install --frozen-lockfile --ignore-scripts
                    '''
                }
            }
        }

        stage('Build XRPL AMM reserve snapshot') {
            steps {
                nodejs(nodeJSInstallationName: 'node') {
                    dir("${env.WORKSPACE}/projects/xrpl-dex") {
                        sh 'node api.js'
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline completed with status: ${currentBuild.currentResult}"
        }
    }
}
