function chunkArray(arr, size) {
  const res = [];
  for (let i = 0; i < arr.length; i += size) res.push(arr.slice(i, i + size));
  return res;
}

async function mergeBalances(target, source) {
  // both target and source are plain objects mapping token -> amount (string)
  for (const [token, amount] of Object.entries(source)) {
    const a = BigInt(target[token] || '0');
    const b = BigInt(amount || '0');
    target[token] = (a + b).toString();
  }
}

async function tvl(api) {
  const chain = api.chain;

  if (chain === 'solana') {
    // Use the Solana-specific helper so historical queries, SPL-token and native SOL
    // balances are preserved (solana helper expects `api` and `solOwners`).
    return solanaSumTokens2({ api, solOwners: SOLANA_OWNERS });
  }

  // Multi-chain EVM Treasury & Intent Vault Tracking
  // Problem: fetchCoValentTokens (discovery) rejects >11 owners. To be robust and
  // keep TVL coverage while keeping changes minimal (fast approval), split owners
  // into batches of <=11 and aggregate results.
  const OWNER_BATCH_SIZE = 11;
  const ownerBatches = chunkArray(EVM_OWNERS, OWNER_BATCH_SIZE);

  if (ownerBatches.length === 1) {
    // single batch: call directly with discovery
    return sumTokens2({ api, owners: EVM_OWNERS, fetchCoValentTokens: true });
  }

  const combined = {};
  for (const batch of ownerBatches) {
    const res = await sumTokens2({ api, owners: batch, fetchCoValentTokens: true });
    // sumTokens2 may return an object of balances. Merge into combined.
    await mergeBalances(combined, res);
  }

  return combined;
}

